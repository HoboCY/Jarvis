{
  "ConnectionStrings": {
    "Jarvis": "Data Source=jarvis.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    },
    "JarvisConsole": {
      "Format": "Simple"
    }
  },
  "OpenAI": {
    "AuthenticationMode": "Bearer",
    "BaseUrl": "https://api.openai.com/",
    "RealtimeVoice": "alloy",
    "AllowedVoices": [
      "alloy"
    ],
    "ClientSecretLifetimeSeconds": 600
  },
  "WakeWord": {
    "Enabled": true,
    "Keyword": "贾维斯"
  },
  "Responses": {
    "Provider": "DeepSeek",
    "Model": "deepseek-v4-flash",
    "SummarizerModel": "deepseek-v4-flash",
    "TimeoutSeconds": 60,
    "MaxTransientRetries": 2,
    "PollingIntervalMs": 250
  },
  "DeepSeek": {
    "BaseUrl": "https://api.deepseek.com/"
  },
  "Diagnostics": {
    "Enabled": true,
    "RequireLoopback": true
  }
}
