{
  "name": "@jarvis/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "../../../node_modules/.bin/eslint --config ../../../eslint.config.mjs src",
    "build": "tsc -p tsconfig.json",
    "bundle:android": "react-native bundle --entry-file index.js --platform android --dev false --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "bundle:ios": "react-native bundle --entry-file index.js --platform ios --dev false --bundle-output ios/main.jsbundle --assets-dest ios"
  },
  "dependencies": {
    "@jarvis/api-client-ts": "workspace:*",
    "@jarvis/contracts-ts": "workspace:*",
    "@jarvis/realtime-agent": "workspace:*",
    "@microsoft/signalr": "8.0.7",
    "@openai/agents-realtime": "0.17.0",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-incall-manager": "4.2.1",
    "react-native-keychain": "10.0.0",
    "react-native-webrtc": "124.0.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-class-static-block": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/preset-env": "7.28.3",
    "@babel/runtime": "7.28.4",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.3.0",
    "@types/react": "19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "jest": "29.7.0",
    "react-test-renderer": "19.2.3",
    "tsx": "4.19.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": "24.19.0"
  }
}
