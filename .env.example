# Copy this file to .env for local Jarvis.Api development. Never commit .env.
# The API reads .env from the process working directory; Desktop and Renderer do not.

# Required: set a random local token with at least 32 characters.
Authentication__BearerToken=
ConnectionStrings__Jarvis=Data Source=jarvis.db

# Required for Realtime: set your OpenAI API key.
OpenAI__ApiKey=
OpenAI__BaseUrl=https://api.openai.com/
# Required for Realtime: set the Realtime model enabled for your account.
OpenAI__RealtimeModel=
OpenAI__RealtimeVoice=alloy
OpenAI__AllowedVoices__0=alloy
# Required: set a random local salt.
OpenAI__SafetyIdentifierSalt=
OpenAI__ClientSecretLifetimeSeconds=600

Responses__Provider=DeepSeek
Responses__Model=deepseek-v4-flash
Responses__SummarizerModel=deepseek-v4-flash
Responses__TimeoutSeconds=60
Responses__MaxTransientRetries=2
Responses__PollingIntervalMs=250

# Required for the default DeepSeek Responses provider: set your DeepSeek API key.
DeepSeek__ApiKey=
DeepSeek__BaseUrl=https://api.deepseek.com/

Diagnostics__Enabled=true
Diagnostics__RequireLoopback=true

# OpenAI remains configured above for Realtime; Responses uses DeepSeek by default.
