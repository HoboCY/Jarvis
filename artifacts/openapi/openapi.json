  "components": {
    "schemas": {
      "ConversationResponse": {
        "required": [
          "id",
          "title",
          "status",
          "lastActivityAtMs",
          "createdAtMs",
          "messages",
          "messageCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ConversationStatusValue"
          },
          "lastActivityAtMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "createdAtMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageResponse"
            }
          },
          "messageCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ConversationStatusValue": {
        "enum": [
          "active",
          "archived"
        ]
      },
      "CreateConversationRequest": {
        "required": [
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DesktopDeviceBootstrapResponse": {
        "required": [
          "deviceId",
          "name",
          "deviceType",
          "platform",
          "status"
        ],
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "deviceType": {
            "$ref": "#/components/schemas/DeviceTypeValue"
          },
          "platform": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/DeviceStatusValue"
          }
        }
      },
      "DeviceStatusValue": {
        "enum": [
          "online",
          "offline",
          "disabled"
        ]
      },
      "DeviceTypeValue": {
        "enum": [
          "desktop",
          "mobile",
          "server"
        ]
      },
      "MessageInputModalityValue": {
        "enum": [
          "voice",
          "typedText",
          "image",
          "tool",
          null
        ]
      },
      "MessageOutputModalityValue": {
        "enum": [
          "audio",
          "text",
          "audioWithTranscript",
          null
        ]
      },
      "MessagePageResponse": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageResponse"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MessageResponse": {
        "required": [
          "id",
          "conversationId",
          "realtimeSessionId",
          "role",
          "inputModality",
          "outputModality",
          "text",
          "status",
          "externalItemId",
          "clientRequestId",
          "sequence",
          "startedAtMs",
          "completedAtMs"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "realtimeSessionId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "role": {
            "$ref": "#/components/schemas/MessageRoleValue"
          },
          "inputModality": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MessageInputModalityValue"
              }
            ]
          },
          "outputModality": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MessageOutputModalityValue"
              }
            ]
          },
          "text": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/MessageStatusValue"
          },
          "externalItemId": {
            "type": [
              "null",
              "string"
            ]
          },
          "clientRequestId": {
            "type": [
              "null",
              "string"
            ]
          },
          "sequence": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "startedAtMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "completedAtMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "MessageRoleValue": {
        "enum": [
          "user",
          "assistant",
          "tool",
          "system"
        ]
      },
      "MessageStatusValue": {
        "enum": [
          "pending",
          "streaming",
          "completed",
          "interrupted",
          "failed"
        ]
      },
      "Phase0HealthResponse": {
        "required": [
          "status",
          "version"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Phase0Status"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Phase0Status": {
        "enum": [
          "ready"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
